APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Maildev (local) : maildev --web 1080 --smtp 1025 → http://127.0.0.1:1080
# Test : php artisan kiel:mail-test
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@kielindustries.com"
MAIL_FROM_NAME="KIEL INDUSTRIES"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connexion / inscription Google (Laravel Socialite)
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web)
# 2. Authorized JavaScript origins : APP_URL (ex. http://localhost:8000)
# 3. Authorized redirect URIs : APP_URL/auth/google/callback (identique à GOOGLE_REDIRECT_URI)
# 4. Coller Client ID et Client secret ci-dessous, puis php artisan config:clear
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Laisser vide pour utiliser APP_URL/auth/google/callback (recommandé)
GOOGLE_REDIRECT_URI=
# En production : false. En local, true évite InvalidStateException si la session ne revient pas de Google.
GOOGLE_OAUTH_STATELESS=
